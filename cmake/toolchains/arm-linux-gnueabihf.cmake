set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
# Configure with -DCAPTURE_TOOLCHAIN_ROOT=/path/to/toolchain.
if(NOT CAPTURE_TOOLCHAIN_ROOT)
    message(FATAL_ERROR "Set CAPTURE_TOOLCHAIN_ROOT to the target toolchain directory")
endif()
set(CMAKE_C_COMPILER "${CAPTURE_TOOLCHAIN_ROOT}/bin/arm-none-linux-gnueabihf-gcc")
set(CMAKE_FIND_ROOT_PATH "${CAPTURE_TOOLCHAIN_ROOT}/arm-none-linux-gnueabihf")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
